{
  "name": "@bradford-tech/mouser-sdk",
  "version": "0.0.1",
  "description": "TypeScript SDK for the Mouser Electronics API",
  "keywords": [
    "mouser",
    "api",
    "sdk",
    "typescript"
  ],
  "homepage": "https://github.com/bradford-tech/mouser-sdk#readme",
  "bugs": {
    "url": "https://github.com/bradford-tech/mouser-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bradford-tech/mouser-sdk.git"
  },
  "license": "MIT",
  "author": "Bradford Technologies <mouser-sdk@sargent.dev>",
  "sideEffects": [
    "./dist/client/client.gen.js"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "fix": "npm run format -- --write && npm run lint -- --fix && npm run type-check",
    "format": "prettier . --log-level warn",
    "generate": "rimraf ./src/client && openapi-ts",
    "lint": "eslint . --quiet --max-warnings 0",
    "prepack": "npm run build",
    "spec:update": "swagger2openapi https://api.mouser.com/api/docs/V1 -o spec/v1.json && swagger2openapi https://api.mouser.com/api/docs/V2 -o spec/v2.json && openapi-merge-cli --config spec/openapi-merge.json",
    "test": "node --import jiti/register --test test/*.test.ts",
    "type-check": "tsc --noEmit"
  },
  "overrides": {
    "js-yaml": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "^0.99.0",
    "eslint": "^10.14.0",
    "eslint-config-flat-gitignore": "^2.4.0",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "openapi-merge-cli": "^2.0.2",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.1.0",
    "rimraf": "^6.1.3",
    "swagger2openapi": "^7.0.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
